# Export these variables in your shell; .env is not automatically loaded.
UGUI_DATA_DIR=./data
UGUI_LLM_URL=http://127.0.0.1:1234/v1
UGUI_LLM_MODEL=local-model
# Set to a local embedding model name to enable semantic retrieval.
UGUI_EMBEDDING_MODEL=
UGUI_EMBEDDING_URL=http://127.0.0.1:1234/v1
UGUI_ALLOW_REMOTE=false
# Optional incoming API authentication (recommended when exposing beyond loopback).
UGUI_API_KEY=
# Optional provider authentication; never committed or logged.
UGUI_LLM_API_KEY=
